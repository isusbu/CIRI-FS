<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>

<configuration>

<property>
  <name>mkfs.ext4.inode.size</name>
  <value>256</value>
  <description>
    Size of inode in bytes. Valid values are 128 and 256. Default is 256. 
    Larger inode size allows extended attributes and improves compatibility 
    with modern ext4 features.
  </description>
</property>

<property>
  <name>mkfs.ext4.lazy.initialization</name>
  <value>true</value>
  <description>
    Enable lazy initialization of inode tables. Default is true. When enabled, 
    inode tables are initialized in background, allowing faster filesystem 
    creation. The filesystem is safe to use immediately.
  </description>
</property>

<property>
  <name>mkfs.ext4.journal.size</name>
  <value>256</value>
  <description>
    Size of the journal in megabytes. Valid range is 16-102400 MB. Default is 
    automatically determined based on filesystem size. Larger journal provides 
    better crash recovery but uses more space.
  </description>
</property>

<property>
  <name>mkfs.ext4.filesystem.features</name>
  <value>has_journal,extent,huge_file,flex_bg,dir_index</value>
  <description>
    Comma-separated list of ext4 features to enable. Common features include: 
    has_journal (enables journaling), extent (uses extent-based storage), 
    huge_file (supports files larger than 2TB), flex_bg (flexible block groups), 
    and dir_index (hashed directory indexes).
  </description>
</property>

<property>
  <name>mkfs.ext4.label</name>
  <value>storage</value>
  <description>
    Optional filesystem label (name). Can be up to 16 characters. Used for 
    identification and mounting by label. Default is empty string.
  </description>
</property>

</configuration>

