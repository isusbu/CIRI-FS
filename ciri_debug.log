# ext4 Filesystem Configuration Example

# Journal mode setting
ext4_journal_mode=writeback

# Block size (must be power of 2: 1024, 2048, 4096)
ext4_block_size=2048

# Inode ratio (number of bytes per inode)
ext4_inode_ratio=16384

# Directory hash version
ext4_dir_hash_version=2

# Metadata checksums
ext4_metadata_csum=true

# 64-bit mode support
ext4_64bit_mode=true

# Maximum file size
ext4_max_file_size=16000000000

# Orphan inode count
ext4_orphan_inode_count=5

# Commit timeout (seconds)
ext4_commit_timeout=5

# Blocks per group
ext4_blocks_per_group=32768

# Mount options
ext4_mount_options=errors=remount-ro,data=ordered

# Journal size - INTENTIONAL ERROR: exceeds total_blocks
ext4_journal_size=999999

# Total blocks in filesystem
ext4_total_blocks=1000

# Encryption enabled with missing key provider - INTENTIONAL ERROR
ext4_encrypt=true

# Encryption key provider - INTENTIONAL ERROR: should have valid provider, not 'none'
ext4_encrypt_key_provider=none

# Quota enabled - INTENTIONAL ERROR: conflicts with noquota_mode
ext4_quota_enabled=true

# Noquota mode - INTENTIONAL ERROR: mutually exclusive with quota_enabled
ext4_noquota_mode=true

# Delayed allocation
ext4_delalloc=true

# Auto commit interval - INTENTIONAL ERROR: can't be 0 with delayed allocation
ext4_auto_commit_interval=0
