# ext4 filesystem configuration - Valid Config

# Encryption disabled - safe
ext4_encrypt=false

# Checksums with 64-bit mode enabled - compatible
ext4_metadata_csum=true
ext4_64bit_mode=true

# Journal size smaller than filesystem
ext4_journal_size=1024
ext4_total_blocks=100000

# Quota enabled with compatible options
ext4_quota_enabled=true
ext4_noquota_mode=false

# Delayed allocation with proper journal settings
ext4_delalloc=true
ext4_auto_commit_interval=5


